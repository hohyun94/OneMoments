# 애플리케이션
NODE_ENV=development
PORT=3900
# 운영에서는 반드시 HTTPS 뒤에 두고 COOKIE_SECURE=true 로 설정한다.

# PostgreSQL (외부 구성). 로컬 DB가 필요하면 docker-compose.db.yml 사용
DATABASE_URL=postgres://onemoments:onemoments@127.0.0.1:55432/onemoments
DATABASE_SSL=disable
DB_POOL_MAX=5

# 세션 쿠키 서명/CSRF 파생 키 (32자 이상)
SESSION_SECRET=replace-with-at-least-32-characters-of-random-secret
SESSION_TTL_SECONDS=43200
COOKIE_SECURE=false

# 브라우저 클라이언트 출처(쉼표 구분). 비우면 CORS 헤더를 보내지 않는다.
CORS_ORIGINS=

# 관리자 콘솔 권한 allowlist(쉼표 구분, username 소문자).
# 비우면 /admin 과 /api/admin 이 모두 비활성화된다.
ADMIN_USERNAMES=

# 메시지 봉투 한도
MAX_CIPHERTEXT_BYTES=16384
MAX_ENVELOPES=50

# 키 백업(복구 암호로 암호화된 블롭) 최대 크기 / 복구 챌린지 유효 시간
BACKUP_MAX_BYTES=8388608
RECOVERY_CHALLENGE_TTL_SECONDS=300

# 첨부 암호문 저장소(파일 이름·MIME·키는 서버가 모른다)
ATTACHMENT_MAX_BYTES=8388608
ATTACHMENT_DIR=./data/attachments
# local | s3. s3는 S3_BUCKET 필요(IAM 역할 또는 ACCESS/SECRET 키).
ATTACHMENT_STORAGE=local
ATTACHMENT_TTL_DAYS=30
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Web Push(VAPID). `pnpm push:keys` 로 생성하고 한 번 정한 키를 유지한다.
# VAPID_PUBLIC_KEY=...
# VAPID_PRIVATE_KEY=...
VAPID_SUBJECT=mailto:you@example.com
PUSH_TTL_SECONDS=3600

# 레이트리밋
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MS=600000
MESSAGE_RATE_LIMIT_MAX=120
MESSAGE_RATE_LIMIT_WINDOW_MS=60000
SEARCH_RATE_LIMIT_MAX=30
SEARCH_RATE_LIMIT_WINDOW_MS=60000

# 모니터링(/metrics) Bearer 토큰(선택, 16자 이상). 비우면 인증 없이 노출된다.
METRICS_TOKEN=
# 다중 인스턴스 메시지 팬아웃(선택). Redis/Dragonfly 호환 URL
REDIS_URL=
REDIS_CHANNEL=onemoments:events
# 기동 시 마이그레이션. 다중 인스턴스에서는 false 로 두고 일회성으로 실행한다.
MIGRATE_ON_START=true

# 리버스 프록시 뒤 x-forwarded-for 신뢰 홉 수
TRUST_PROXY=0

# Google OAuth(선택). 세 값이 모두 있어야 소셜 로그인이 활성화된다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=
# OAuth 완료 후 돌아갈 SPA 주소(기본: GOOGLE_REDIRECT_URL 의 origin)
APP_ORIGIN=

# 1:1 음성 통화(WebRTC). 시그널링은 WS, 미디어는 P2P(불가 시 TURN) 로 흐른다.
# 끄려면 false. 끄면 통화 버튼과 시그널링이 모두 비활성화된다.
# 가입 정책: open(누구나) / invite(초대 코드 필요) / closed(가입 중지)
SIGNUP_MODE=open
LINK_PREVIEW_ENABLED=true
# 지도 타일 템플릿(설정 시 위치 공유에서 지도 이미지 사용, 예: https://tile.openstreetmap.org/{z}/{x}/{y}.png)
MAP_TILE_URL=
CALL_ENABLED=true
# STUN/TURN 목록은 쉼표 구분. 예) stun:turn.example.com:3478
CALL_STUN_URLS=
# TURN 을 쓰려면 CALL_TURN_SECRET(coturn static-auth-secret)이 함께 필요하다.
# 예) turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349
CALL_TURN_URLS=
CALL_TURN_SECRET=
# TURN 자격증명 유효 시간(초)과 수신 벨 타임아웃(초)
CALL_TURN_TTL_SECONDS=600
CALL_RING_TIMEOUT_SECONDS=30

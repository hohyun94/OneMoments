{
  "name": "onemoments",
  "version": "0.1.0",
  "private": true,
  "description": "Personal 1:1 E2E-encrypted messenger server: stores ciphertext envelopes only.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "dev:client": "pnpm --filter @onemoments/client dev",
    "build": "tsc -p tsconfig.json && pnpm build:client",
    "build:server": "tsc -p tsconfig.json",
    "build:client": "pnpm --filter @onemoments/client build",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "check": "tsc --noEmit -p tsconfig.json",
    "check:test": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:client": "pnpm --filter @onemoments/client test",
    "test:e2e": "pnpm build && playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "db:backup": "node --env-file-if-exists=.env scripts/backup.mjs",
    "db:restore": "node --env-file-if-exists=.env scripts/restore.mjs",
    "db:load-test": "node --env-file-if-exists=.env scripts/load-test.mjs",
    "attachments:cleanup": "node --env-file-if-exists=.env scripts/cleanup-attachments.mjs",
    "push:keys": "node scripts/generate-vapid-keys.mjs",
    "icons:pwa": "node scripts/generate-pwa-icons.mjs",
    "bench:crypto": "tsx scripts/crypto-bench.ts",
    "verify": "pnpm check && pnpm build",
    "verify:full": "pnpm check:test && pnpm test && pnpm test:client && pnpm verify",
    "verify:all": "pnpm verify:full && pnpm test:e2e"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1168.0",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.44.5",
    "express": "^4.21.2",
    "pg": "^8.16.3",
    "redis": "^4.7.0",
    "ws": "^8.18.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.1",
    "@types/node": "^24.7.0",
    "@types/pg": "^8.15.5",
    "@types/ws": "^8.5.12",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.19.3",
    "typescript": "5.9.3",
    "vitest": "^3.0.9"
  }
}

{
  "name": "onemoments",
  "version": "0.1.0",
  "private": true,
  "description": "Personal 1:1 E2E-encrypted messenger server: stores ciphertext envelopes only.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "check": "tsc --noEmit -p tsconfig.json",
    "check:test": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "verify": "pnpm check && pnpm build",
    "verify:full": "pnpm check:test && pnpm test && pnpm verify"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.44.5",
    "express": "^4.21.2",
    "pg": "^8.16.3",
    "ws": "^8.18.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.1",
    "@types/node": "^24.7.0",
    "@types/pg": "^8.15.5",
    "@types/ws": "^8.5.12",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.19.3",
    "typescript": "5.9.3",
    "vitest": "^3.0.9"
  }
}
